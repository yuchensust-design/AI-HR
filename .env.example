# Supabase Auth + DB(plan §8.24)
# 1. https://supabase.com 注册项目 → 拿到 Project URL + Publishable + Secret keys
# 2. Supabase SQL Editor 跑一次 supabase/migrations/001_init.sql
# 3. 把下面值填到 .env.local(.env.local 在 .gitignore,不会进仓)
# 4. Vercel 部署:Project Settings → Environment Variables 添加这 3 个

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# LLM(沿用现有 main 配置)
DEEPSEEK_API_KEY=
HUNYUAN_API_KEY=
